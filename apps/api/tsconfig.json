{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "strictPropertyInitialization": false,
    "paths": {
      "@jambaar/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@nestjs/config": [
        "../../node_modules/@nestjs/config"
      ]
    }
  },
  "include": [
    "src",
    "prisma/seed"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test"
  ]
}