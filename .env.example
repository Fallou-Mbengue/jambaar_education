# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://jambaar:changeme@localhost:5432/jambaar

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:changeme@localhost:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret-at-least-64-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret-at-least-64-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── MinIO (S3-compatible) ────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=jambaar

# ─── AI / LLM ─────────────────────────────────────────────────────────────────
USE_MOCK_LLM=true
OPENAI_API_KEY=sk-replace-with-real-key
OPENAI_MODEL=gpt-4o-mini

# ─── Payment (Mobile Money) ────────────────────────────────────────────────────
WAVE_API_KEY=replace-with-real-wave-key
WAVE_API_URL=https://api.wave.com/v1
ORANGE_MONEY_API_KEY=replace-with-real-om-key
ORANGE_MONEY_API_URL=https://api.orange-money.sn/v1
WEBHOOK_SECRET=replace-with-webhook-signing-secret

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
CORS_ORIGINS=http://localhost:3000

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Docker (for docker-compose) ──────────────────────────────────────────────
DB_PASSWORD=changeme
REDIS_PASSWORD=changeme
